APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=db_playground
# POSTGRES_USER/PASSWORD: the app's own unprivileged database role (NOSUPERUSER),
# created by backend/docker/postgres-init/01-create-app-role.sh. This is what the
# backend actually connects as -- not the bootstrap superuser below.
POSTGRES_USER=db_playground
POSTGRES_PASSWORD=change-me
# POSTGRES_ADMIN_PASSWORD: password for the postgres image's own bootstrap
# superuser ("postgres"). Only the init script above uses it; the app never does.
POSTGRES_ADMIN_PASSWORD=change-me-admin
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=db_playground
# MONGODB_USERNAME/PASSWORD: the app's own user, scoped to readWrite+dbAdmin on
# MONGODB_DATABASE only (see backend/docker/mongo-init/01-create-app-user.js).
MONGODB_USERNAME=db_playground
MONGODB_PASSWORD=change-me
# MONGODB_ADMIN_PASSWORD: password for the mongo image's own root bootstrap user.
# Only the init script above uses it; the app never does.
MONGODB_ADMIN_PASSWORD=change-me-admin
QUERY_TIMEOUT_SECONDS=10
QUERY_MAX_ROWS=500
DOCUMENT_QUERY_MAX_RESULTS=500
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000